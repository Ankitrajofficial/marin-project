# Copy to .env.local. Both values are optional -- the defaults are the
# single-origin setup and need no .env.local at all.

# Where the browser sends API calls. LEAVE UNSET for the normal setup: the
# frontend then uses relative URLs and next.config.mjs proxies /api/* to the
# backend, so http://localhost:3000 is the only address anyone needs.
#
# Set it ONLY to bypass that proxy and call a backend on another origin, which
# then also needs that origin added to the API's CORS allow-list in
# backend/app/api/main.py.
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Where the Next server's /api/* proxy forwards to. Server-side only; never
# reaches the browser. Default: http://127.0.0.1:8000
# ORCA_API_ORIGIN=http://127.0.0.1:8000
