# Copy to .env and fill in. .env is gitignored.

DATABASE_URL=postgresql://orca:orca@localhost:5432/orca

# The conversational layer (agents/) needs this. The deterministic layer --
# ingest, risk, geofencing, the map, and every API endpoint except /api/chat --
# works without it.
#
# Provider and model are set in backend/app/config.py (llm_provider,
# llm_model). Default is Gemini via its OpenAI-compatible endpoint.
GEMINI_API_KEY=

# Tier 2 sources (registration required) — leave blank until needed.
AISSTREAM_API_KEY=
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
BHASHINI_API_KEY=
